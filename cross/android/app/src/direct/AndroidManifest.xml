<?xml version="1.0" encoding="utf-8"?>
<!-- The build published on the project's release page updates itself: it may install a downloaded new version
     over this one. The Google Play build (src/play) has no such permission. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
</manifest>
